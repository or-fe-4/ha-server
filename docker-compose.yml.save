services:
  lb:
    image: nginx:latest
    ports:
      - "80:80"
    volumes:
      - ./nginx.conf:/etc/nginx/conf.d/default.conf
    depends_on:
      - web1
      - web2

  web1:
    image: nginx:latest
    volumes:
      - ./web1:/usr/share/nginx/html

  web2:
    image: nginx:latest
    volumes:
      - ./web2:/usr/share/nginx/html
